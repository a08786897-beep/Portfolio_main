# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection
# Use local MongoDB for development or MongoDB Atlas for production
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/portfolio

# CORS Allowed Origins (comma-separated list of origins)
# In production, set this to your frontend URL (e.g. https://your-portfolio.vercel.app)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5502,http://127.0.0.1:5502
